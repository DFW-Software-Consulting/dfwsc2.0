# Root .env.example — copy to .env and fill in values
# Used by both backend (API) and frontend (Vite)

# -----------------------------------------------
# Stripe — get from https://dashboard.stripe.com/apikeys
# -----------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------
# Database
# -----------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db:5432/stripe_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stripe_portal

# -----------------------------------------------
# Admin Authentication (JWT)
# -----------------------------------------------
# Admin panel login is checked against Nextcloud (NEXTCLOUD_* below); there are no
# local admin accounts. A user may sign in when their Nextcloud account belongs to
# one of ADMIN_NEXTCLOUD_GROUPS. Accounts with two-factor login need a Nextcloud
# app password. If Nextcloud is down or not configured, admin login answers 503
# (payments are unaffected).
# Comma-separated Nextcloud group ids (the groups must exist, with members, BEFORE deploying).
ADMIN_NEXTCLOUD_GROUPS=dfwsc-admins,managers
# -----------------------------------------------
JWT_SECRET=change_me_min_32_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRY=1h

# -----------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# -----------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------
# Payment
# -----------------------------------------------
DEFAULT_PROCESS_FEE_CENTS=100
# Optional Checkout redirect defaults used after client/group URLs and before FRONTEND_ORIGIN fallback.
# DFWSC frontend fallback examples:
# DEFAULT_PAYMENT_SUCCESS_URL=http://localhost:5173/payment-success
# DEFAULT_PAYMENT_CANCEL_URL=http://localhost:5173/payment-cancel

# -----------------------------------------------
# SMTP
# Local dev:  mailhog values below work out of the box
# Production: replace with real SMTP credentials
# -----------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=noreply@yourdomain.com

# Recipient for public contact-form submissions (POST /api/v1/contact).
# Falls back to SMTP_FROM above when unset.
# CONTACT_INBOX=hello@yourdomain.com

# -----------------------------------------------
# Frontend (Vite)
# Only used for local dev outside Docker.
# Docker builds bake VITE_API_URL in as a build arg — see docker-compose files.
# -----------------------------------------------
VITE_API_URL=http://localhost:4242/api/v1

# Cookieless, Plausible-compatible analytics — off by default.
# Analytics is a complete no-op (no script injected, no network calls) unless
# VITE_ANALYTICS_SRC is set. Never commit a real analytics domain here.
# VITE_ANALYTICS_SRC=https://plausible.example.com/js/script.js
# VITE_ANALYTICS_DOMAIN=yourdomain.com

# -----------------------------------------------
# Optional / advanced
# -----------------------------------------------
# Override the server port (default: 4242)
# PORT=4242

# Override the public API base URL (auto-detected if not set)
# API_BASE_URL=https://api.yourdomain.com

# Redis — recommended in production for rate limiting (shared counters that survive API restarts).
# If Redis is unreachable, the limiter falls back to per-process in-memory buckets and logs the
# error at most once every 30 seconds; requests are not rejected.
# REDIS_URL=redis://localhost:6379

# Nextcloud service account (an app password, not the login password). Shared by every
# Nextcloud integration; each one is optional and off unless its own flag is set.
# NEXTCLOUD_BASE_URL=https://cloud.example.com
# NEXTCLOUD_USERNAME=cerebo-bot
# NEXTCLOUD_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# "DFWSC — New Lead" automation (docs/BACKEND.md, "Sales lead automation"). Off unless
# SALES_AUTOMATION_ENABLED=true; the rest are then required. An invalid config is logged
# once at startup and the poller stays off; the payment API is never affected.
# SALES_AUTOMATION_ENABLED=false
# SALES_LEAD_FORM_ID=12
# SALES_PIPELINE_TABLE_ID=8
# Address book collection as the service account sees it (a shared book ends "_shared_by_<owner>").
# SALES_ADDRESSBOOK_PATH=dfwsc-sales_shared_by_messyginger0804
# Lead folders are created below this path, relative to the service account's files root.
# SALES_LEADS_FOLDER=DFWSC Sales/Leads
# Poll interval in ms (default 120000, minimum 30000).
# SALES_POLL_INTERVAL_MS=120000

# "DFWSC — Convert Won Lead to Client" onboarding (docs/BACKEND.md, "Client Onboarding
# Automation"). Off unless CLIENT_ONBOARDING_ENABLED=true; the ids, address book and
# folder are then required. Uses the NEXTCLOUD_* service account above. An invalid
# config is logged once at startup and nothing runs; the payment API is never affected.
# CLIENT_ONBOARDING_ENABLED=false
# CLIENT_ONBOARDING_FORM_ID=2
# CLIENT_ONBOARDING_PROJECTS_TABLE_ID=6
# CLIENT_ONBOARDING_PIPELINE_TABLE_ID=8
# CLIENT_ONBOARDING_ADDRESSBOOK_PATH=dfwsc-sales_shared_by_messyginger0804
# Client folders are created below this path, relative to the service account's files root.
# CLIENT_ONBOARDING_CLIENTS_FOLDER=clients
# CLIENT_ONBOARDING_COLLECTIVE_ID=1
# Shared secret Nextcloud sends as "Authorization: Bearer <secret>" to
# POST /api/v1/webhooks/nextcloud/client-onboarding (at least 32 characters, e.g.
# `openssl rand -hex 32`). Unset: the webhook answers 404 and only the poll runs.
# CLIENT_ONBOARDING_WEBHOOK_SECRET=
# Safety-net poll in ms (default 300000, minimum 30000).
# CLIENT_ONBOARDING_POLL_INTERVAL_MS=300000
# Per-project Teams (docs/BACKEND.md section 10). Off by default. When true, each new project also
# gets a Nextcloud Team "CP-### <Project name>", a wiki (collective) of the same name holding the
# Project Brief, and the client folder shared with the team. Needs CLIENT_ONBOARDING_TEAM_ADMINS and
# reshare rights for dfwsc-admin on the clients folder.
# CLIENT_ONBOARDING_PROJECT_TEAMS=false
# Comma-separated Nextcloud user ids added to every project team as admins (ids may contain spaces).
# CLIENT_ONBOARDING_TEAM_ADMINS=
# Billing Customer (docs/BACKEND.md section 10). Off by default. When true, each New Client submission also
# finds (by email) or creates a Stripe Customer on DFWSC's own platform account and records it in
# billing_customers. Separate from Stripe Connect; a Stripe outage keeps the submission pending and retried.
# CLIENT_ONBOARDING_BILLING_CUSTOMER=false
# Contact card -> billing Customer sync (docs/BACKEND.md section 11). Off by default. When true, edits to a
# client's onboarding contact card (dfwsc-client-* in CLIENT_ONBOARDING_ADDRESSBOOK_PATH, linked to a billing
# Customer) are pushed to that Stripe Customer: name (ORG, else FN), email ("Account email" label), phone
# ("Account phone"), address ("Billing address"). Nextcloud wins; nothing is written back. The first sighting of a
# card only records a baseline. Needs NEXTCLOUD_* and CLIENT_ONBOARDING_ADDRESSBOOK_PATH.
# CONTACT_STRIPE_SYNC=false
# Poll interval in ms (default 120000, minimum 10000).
# CONTACT_STRIPE_SYNC_INTERVAL_MS=120000

# Portal Accounts mirror (docs/BACKEND.md section 12). Off by default. When true, the API keeps a read-only
# Nextcloud Table "Portal Accounts" (one row per portal client, plus payment aggregates) up to date and shares it
# read-only with PORTAL_MIRROR_SHARE_GROUPS. The database wins; edits made in Nextcloud are overwritten.
# Needs NEXTCLOUD_*; the table is created by the API as NEXTCLOUD_USERNAME. Payments are not mirrored row by row.
# PORTAL_MIRROR=false
# Poll interval in ms (default 60000, minimum 10000) and rows handled per cycle (default 25, maximum 100).
# PORTAL_MIRROR_INTERVAL_MS=60000
# PORTAL_MIRROR_BATCH=25
# Nextcloud groups that get read-only access (default dfwsc-admins,managers).
# PORTAL_MIRROR_SHARE_GROUPS=dfwsc-admins,managers
# Show archived clients (default false).
# PORTAL_MIRROR_INCLUDE_ARCHIVED=false
# Fallback: use a hand-made table (its column titles must match) instead of letting the API create and share one.
# PORTAL_ACCOUNTS_TABLE_ID=

# Client Billing mirror (docs/BACKEND.md section 13). Off by default. When true, the API keeps a read-only
# Nextcloud Table "Client Billing" (one row per billing_customers client code: status, subscription, payments,
# balances) up to date from Stripe LISTS and shares it read-only with BILLING_MIRROR_SHARE_GROUPS. Stripe is only
# read, never written. Needs NEXTCLOUD_*; uses PORTAL_MIRROR_INTERVAL_MS and PORTAL_MIRROR_BATCH for the loop.
# BILLING_MIRROR=false
# Nextcloud groups that get read-only access (default dfwsc-admins,managers).
# BILLING_MIRROR_SHARE_GROUPS=dfwsc-admins,managers
# Every Customer is re-read from Stripe at boot and this often, in ms (default 3600000, minimum 60000).
# BILLING_SWEEP_INTERVAL_MS=3600000
# Signing secret of the ACCOUNT-level Stripe webhook endpoint POST /api/v1/webhooks/stripe-billing (docs/STRIPE.md).
# Unset: the endpoint answers 404 and the hourly sweep alone keeps the data fresh.
# STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# "New invoice" form (docs/BACKEND.md section 14). Off by default. When true, each submission of the Nextcloud form
# BILLING_REQUESTS_FORM_ID creates a one-off Stripe invoice or a recurring plan (Subscription Schedule) for a client in
# billing_customers, on DFWSC's own Stripe account (never Connect). REAL INVOICES in production. Results are listed in a
# read-only Nextcloud Table "Billing Requests". Needs NEXTCLOUD_*; submissions that exist when it is first enabled are skipped.
# BILLING_REQUESTS_ENABLED=false
# BILLING_REQUESTS_FORM_ID=
# Shared secret (at least 32 characters) of the webhook POST /api/v1/webhooks/nextcloud/billing-request
# (header Authorization: Bearer <secret>). Unset: the webhook answers 404 and only the poll runs.
# BILLING_REQUESTS_WEBHOOK_SECRET=
# Poll interval in ms (default 300000, minimum 30000).
# BILLING_REQUESTS_POLL_INTERVAL_MS=300000
# Nextcloud groups whose members may submit (checked by the API, in addition to the form's own restriction).
# BILLING_REQUESTS_ALLOWED_GROUPS=dfwsc-admins,managers
# Nextcloud groups that get read-only access to the "Billing Requests" table.
# BILLING_REQUESTS_SHARE_GROUPS=dfwsc-admins,managers
# A submission older than this many hours (Forms timestamp) is marked Expired and never billed, unless Stripe was
# already created in Stripe for it (then it is resumed whatever its age). Default 72.
# BILLING_REQUESTS_MAX_AGE_HOURS=72
# Largest amount in cents per invoice, or per payment of a plan (default 2500000 = $25,000).
# BILLING_MAX_AMOUNT_CENTS=2500000
# true (default): finalize and email each one-off invoice; false: leave it as a draft in Stripe.
# BILLING_AUTO_SEND=true
# Days an invoice or plan payment stays due (default 7).
# BILLING_DEFAULT_DAYS_UNTIL_DUE=7

# Connected-account invoicing API (docs/BACKEND.md section 7, docs/STRIPE.md). Global kill switch, off by default: only the exact
# value "true" registers the /api/v1/customers routes (anything else: they answer 404). A client also needs its own
# invoicing_enabled flag (admin PATCH /clients/:id). Calls run on the client's own Express account, never the platform's.
# CONNECT_INVOICING=false

# Set to 'false' to disable Swagger UI (always disabled in production)
# ENABLE_SWAGGER=true

# Metrics — bearer token for GET /api/v1/metrics (Prometheus scrape endpoint).
# Fail-closed: if unset, /metrics is DISABLED (returns 404). Set in production.
# METRICS_TOKEN=change_me_metrics_bearer_token

# Reverse proxies trusted for X-Forwarded-For (request.ip / per-IP rate limits).
# Default trusts private-network proxies: loopback,linklocal,uniquelocal.
# Accepts true, false, or a comma-separated IP/CIDR list. Numeric hop counts are no longer supported.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Cloudflare edge CIDRs (comma-separated) whose CF-Connecting-IP header is trusted for per-IP rate limits (IPv6 visitors are limited per /64 prefix).
# Defaults to the built-in Cloudflare list; set to "none" to ignore CF-Connecting-IP entirely.
# CLOUDFLARE_IP_RANGES=

# Enable MailHog integration tests
# MAILHOG_ENABLED=true

# -----------------------------------------------
# Backups (dfwsc-backup image)
# See docs/BACKUP.md for restore drills and healthcheck details.
# -----------------------------------------------
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=backups/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL_S3=
# BACKUP_HEARTBEAT_MAX_AGE=90000
