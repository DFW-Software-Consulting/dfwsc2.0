#!/usr/bin/env sh

check_agent_docs_sync() {
  base="CLAUDE.md"
  mirrors="AGENTS.md Qwen.md Gemini.md .claude/CLAUDE.md"

  if [ ! -f "$base" ]; then
    echo "❌ Missing required file: $base"
    return 1
  fi

  missing=""
  for file in $mirrors; do
    if [ ! -f "$file" ]; then
      missing="$missing $file"
    fi
  done

  if [ -n "$missing" ]; then
    echo "❌ Missing required mirror file(s):$missing"
    return 1
  fi

  for file in $mirrors; do
    if ! diff -q "$base" "$file" >/dev/null 2>&1; then
      echo "❌ '$file' is out of sync with $base"
      echo "   Sync them with: cp CLAUDE.md AGENTS.md && cp CLAUDE.md Qwen.md && cp CLAUDE.md Gemini.md && cp CLAUDE.md .claude/CLAUDE.md"
      return 1
    fi
  done
}

# Runs a command with quiet success output and full failure logs.
run_step() {
  label="$1"
  shift

  log_file=$(mktemp)

  if "$@" >"$log_file" 2>&1; then
    rm -f "$log_file"
  else
    echo "❌ ${label} check failed"
    cat "$log_file"
    rm -f "$log_file"
    exit 1
  fi
}

# 1. Guard: no force-push to main
while read -r local_ref local_sha remote_ref remote_sha; do
  if echo "$remote_ref" | grep -q 'refs/heads/main'; then
    echo "❌ Force-pushing to main is not allowed."
    exit 1
  fi
done

# 2. Backend tests inside Docker (moved from pre-commit — runs once per push, not per commit)
COMPOSE="docker compose -f docker-compose.base.yml -f docker-compose.dev.yml"

if [ "${SKIP_DOCKER_TESTS}" = "1" ]; then
  echo "⚠️  SKIP_DOCKER_TESTS=1 — backend tests skipped."
elif $COMPOSE ps --status running 2>/dev/null | grep -q "api"; then
  run_step "Backend tests (coverage 87/79/82/87)" $COMPOSE exec -T api npm run test:coverage
else
  echo ""
  echo "❌ Docker stack is not running. Start it with 'make up' before pushing."
  echo "   To skip backend tests: SKIP_DOCKER_TESTS=1 git push"
  echo ""
  exit 1
fi

# 3. Full lint (Biome check)
run_step "Lint" npm run lint

# 4. Guard: agent-doc mirrors must exist and stay in sync with CLAUDE.md
run_step "Agent docs" check_agent_docs_sync

# 5. Backend TypeScript type-check
run_step "Backend type-check" sh -c "cd backend && npx tsc --noEmit -p tsconfig.build.json && npx tsc --noEmit -p tsconfig.json"

# 6. Frontend build
run_step "Frontend build" npm run build:frontend

# 7. Frontend tests
run_step "Frontend tests" npm run test:front

# 8. Prod image build (mirrors the CI "build" job)
if [ "${SKIP_DOCKER_BUILD}" = "1" ]; then
  echo "⚠️  SKIP_DOCKER_BUILD=1 — prod image build skipped."
else
  run_step "Prod build" docker compose -f docker-compose.prod.yml build
fi
