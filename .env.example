# Root .env.example — copy to .env and fill in values
# Used by both backend (API) and frontend (Vite)

# -----------------------------------------------
# Stripe — get from https://dashboard.stripe.com/apikeys
# -----------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------
# Database
# -----------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db:5432/stripe_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stripe_portal

# -----------------------------------------------
# Admin Authentication (JWT)
# -----------------------------------------------
# Accounts are managed via the database.
# First-time setup: enable ALLOW_ADMIN_SETUP=true and set ADMIN_USERNAME/
# ADMIN_PASSWORD, then log in and confirm via /auth/confirm-bootstrap.
# -----------------------------------------------
JWT_SECRET=change_me_min_32_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRY=1h

# -----------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# -----------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------
# Payment
# -----------------------------------------------
DEFAULT_PROCESS_FEE_CENTS=100
# Optional Checkout redirect defaults used after client/group URLs and before FRONTEND_ORIGIN fallback.
# DFWSC frontend fallback examples:
# DEFAULT_PAYMENT_SUCCESS_URL=http://localhost:5173/payment-success
# DEFAULT_PAYMENT_CANCEL_URL=http://localhost:5173/payment-cancel

# -----------------------------------------------
# SMTP
# Local dev:  mailhog values below work out of the box
# Production: replace with real SMTP credentials
# -----------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=noreply@yourdomain.com

# Recipient for public contact-form submissions (POST /api/v1/contact).
# Falls back to SMTP_FROM above when unset.
# CONTACT_INBOX=hello@yourdomain.com

# -----------------------------------------------
# Frontend (Vite)
# Only used for local dev outside Docker.
# Docker builds bake VITE_API_URL in as a build arg — see docker-compose files.
# -----------------------------------------------
VITE_API_URL=http://localhost:4242/api/v1

# Cookieless, Plausible-compatible analytics — off by default.
# Analytics is a complete no-op (no script injected, no network calls) unless
# VITE_ANALYTICS_SRC is set. Never commit a real analytics domain here.
# VITE_ANALYTICS_SRC=https://plausible.example.com/js/script.js
# VITE_ANALYTICS_DOMAIN=yourdomain.com

# -----------------------------------------------
# Optional / advanced
# -----------------------------------------------
# Override the server port (default: 4242)
# PORT=4242

# Override the public API base URL (auto-detected if not set)
# API_BASE_URL=https://api.yourdomain.com

# Redis — recommended in production for rate limiting (shared counters that survive API restarts).
# If Redis is unreachable, the limiter falls back to per-process in-memory buckets and logs the
# error at most once every 30 seconds; requests are not rejected.
# REDIS_URL=redis://localhost:6379

# Nextcloud service account (an app password, not the login password). Shared by every
# Nextcloud integration; each one is optional and off unless its own flag is set.
# NEXTCLOUD_BASE_URL=https://cloud.example.com
# NEXTCLOUD_USERNAME=cerebo-bot
# NEXTCLOUD_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# "DFWSC — New Lead" automation (docs/BACKEND.md, "Sales lead automation"). Off unless
# SALES_AUTOMATION_ENABLED=true; the rest are then required. An invalid config is logged
# once at startup and the poller stays off; the payment API is never affected.
# SALES_AUTOMATION_ENABLED=false
# SALES_LEAD_FORM_ID=12
# SALES_PIPELINE_TABLE_ID=8
# Address book collection as the service account sees it (a shared book ends "_shared_by_<owner>").
# SALES_ADDRESSBOOK_PATH=dfwsc-sales_shared_by_messyginger0804
# Lead folders are created below this path, relative to the service account's files root.
# SALES_LEADS_FOLDER=DFWSC Sales/Leads
# Poll interval in ms (default 120000, minimum 30000).
# SALES_POLL_INTERVAL_MS=120000

# "DFWSC — Convert Won Lead to Client" onboarding (docs/BACKEND.md, "Client Onboarding
# Automation"). Off unless CLIENT_ONBOARDING_ENABLED=true; the ids, address book and
# folder are then required. Uses the NEXTCLOUD_* service account above. An invalid
# config is logged once at startup and nothing runs; the payment API is never affected.
# CLIENT_ONBOARDING_ENABLED=false
# CLIENT_ONBOARDING_FORM_ID=2
# CLIENT_ONBOARDING_PROJECTS_TABLE_ID=6
# CLIENT_ONBOARDING_PIPELINE_TABLE_ID=8
# CLIENT_ONBOARDING_ADDRESSBOOK_PATH=dfwsc-sales_shared_by_messyginger0804
# Client folders are created below this path, relative to the service account's files root.
# CLIENT_ONBOARDING_CLIENTS_FOLDER=clients
# CLIENT_ONBOARDING_COLLECTIVE_ID=1
# Shared secret Nextcloud sends as "Authorization: Bearer <secret>" to
# POST /api/v1/webhooks/nextcloud/client-onboarding (at least 32 characters, e.g.
# `openssl rand -hex 32`). Unset: the webhook answers 404 and only the poll runs.
# CLIENT_ONBOARDING_WEBHOOK_SECRET=
# Safety-net poll in ms (default 300000, minimum 30000).
# CLIENT_ONBOARDING_POLL_INTERVAL_MS=300000

# Set to 'false' to disable Swagger UI (always disabled in production)
# ENABLE_SWAGGER=true

# Metrics — bearer token for GET /api/v1/metrics (Prometheus scrape endpoint).
# Fail-closed: if unset, /metrics is DISABLED (returns 404). Set in production.
# METRICS_TOKEN=change_me_metrics_bearer_token

# Reverse proxies trusted for X-Forwarded-For (request.ip / per-IP rate limits).
# Default trusts private-network proxies: loopback,linklocal,uniquelocal.
# Accepts true, false, or a comma-separated IP/CIDR list. Numeric hop counts are no longer supported.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Cloudflare edge CIDRs (comma-separated) whose CF-Connecting-IP header is trusted for per-IP rate limits (IPv6 visitors are limited per /64 prefix).
# Defaults to the built-in Cloudflare list; set to "none" to ignore CF-Connecting-IP entirely.
# CLOUDFLARE_IP_RANGES=

# Enable MailHog integration tests
# MAILHOG_ENABLED=true

# Bootstrap mode — first-run admin account creation from env vars
# (set all three, then set ALLOW_ADMIN_SETUP=false after confirming)
# ALLOW_ADMIN_SETUP=true
# ADMIN_USERNAME=your-admin-username
# ADMIN_PASSWORD=a-strong-password-12-chars-min
# SETUP_FLAG_PATH=/data/admin-setup-used

# -----------------------------------------------
# Backups (dfwsc-backup image)
# See docs/BACKUP.md for restore drills and healthcheck details.
# -----------------------------------------------
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=backups/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL_S3=
# BACKUP_HEARTBEAT_MAX_AGE=90000
